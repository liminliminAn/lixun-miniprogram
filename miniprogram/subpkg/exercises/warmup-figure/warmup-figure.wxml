<view class="empty" wx:if="{{empty}}">
  <view class="empty-tip">没有可显示的图解内容</view>
  <view class="empty-btn" bindtap="onBack">返回</view>
</view>
<view class="container" wx:if="{{!empty}}">
  <image class="img" wx:if="{{showImg}}" src="{{img}}" mode="aspectFit" binderror="onImgError" />
  <view class="img-fail" wx:if="{{imgFailed}}">{{imgFailHint}}</view>
  <view class="card" wx:if="{{title || cue}}">
    <view class="sec" wx:if="{{title}}">{{title}}</view>
    <view class="tip" wx:if="{{cue}}">{{cue}}</view>
  </view>
</view>
