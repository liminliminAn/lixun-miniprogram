<view class="empty" wx:if="{{empty}}">
  <view class="empty-tip">没有可显示的图解内容</view>
  <view class="empty-btn" bindtap="onBack">返回</view>
</view>
<view class="container" wx:if="{{card}}">
  <image class="img" webp="{{true}}" wx:if="{{showImg}}" src="{{card.detailImage}}" mode="aspectFit" binderror="onImgError" />
  <view class="card">
    <view class="sec">步骤</view>
    <view class="tip" wx:for="{{card.steps}}" wx:key="*this"><text class="bullet">{{index + 1}}</text><text>{{item}}</text></view>
    <view class="sec">要点提示</view>
    <view class="tip" wx:for="{{card.cues}}" wx:key="*this"><text class="bullet">●</text><text>{{item}}</text></view>
    <view class="sec">常见错误</view>
    <view class="tip" wx:for="{{card.mistakes}}" wx:key="*this"><text class="bad">✕</text><text>{{item}}</text></view>
    <view class="dose" wx:if="{{card.dose}}">正式组：{{card.dose}}</view>
    <view class="dose-note" wx:if="{{card.doseNote}}">{{card.doseNote}}</view>
    <block wx:if="{{card.contraindications.length}}">
      <view class="sec">注意</view>
      <view class="tip" wx:for="{{card.contraindications}}" wx:key="*this"><text class="bad">!</text><text>{{item}}</text></view>
    </block>
    <view class="dose-note medical">{{card.medicalNote}}</view>
  </view>
</view>
