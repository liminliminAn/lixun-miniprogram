.img { width: 100%; height: 480rpx; border-radius: 24rpx; background: var(--color-surface); margin-bottom: var(--space-3); }
.sec { font-size: var(--font-section); font-weight: 600; color: var(--color-ink); margin: var(--space-3) 0 var(--space-1); }
.tip { display: flex; gap: var(--space-2); font-size: var(--font-meta); color: var(--color-ink); line-height: 1.6; }
.bullet { color: var(--color-accent); min-width: 32rpx; }
.bad { color: var(--color-danger); min-width: 32rpx; }
.dose { font-size: var(--font-meta); color: var(--color-ink); margin-top: var(--space-3); }
.dose-note { font-size: var(--font-caption); color: var(--color-ink-secondary); }
.medical { margin-top: var(--space-3); }

.empty { padding: 160rpx var(--space-3); text-align: center; }
.empty-tip { font-size: var(--font-meta); color: var(--color-ink-secondary); margin-bottom: var(--space-3); }
.empty-btn { display: inline-block; padding: 16rpx 48rpx; border-radius: 24rpx; background: var(--color-accent); color: var(--color-accent-ink); }
.img-fail { padding: var(--space-3); margin-bottom: var(--space-3); border-radius: 24rpx; background: var(--color-surface); color: var(--color-ink-secondary); font-size: 26rpx; text-align: center; }
