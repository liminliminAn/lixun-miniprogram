.img { width: 100%; height: 480rpx; border-radius: var(--radius-card); background: var(--color-surface); margin-bottom: var(--space-3); }
.sec { font-size: var(--font-section); font-weight: 600; color: var(--color-ink); margin: var(--space-3) 0 var(--space-1); }
.tip { display: flex; gap: var(--space-2); font-size: var(--font-meta); color: var(--color-ink); line-height: 1.6; }
.bullet { color: var(--color-accent); min-width: 32rpx; }
.bad { color: var(--color-danger); min-width: 32rpx; }
.dose { font-size: var(--font-meta); color: var(--color-ink); margin-top: var(--space-3); }
.dose-note { font-size: var(--font-caption); color: var(--color-ink-secondary); }
