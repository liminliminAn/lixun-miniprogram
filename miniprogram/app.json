    "pages/log/log",
    "pages/diet/diet",
    "pages/me/me",
    "pages/onboarding/onboarding",
    "pages/session/session"
  ],
  "window": {
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTitleText": "力训",
    "navigationBarTextStyle": "@navText",
