      {
        "pagePath": "pages/plan/plan",
        "text": "计划",
        "iconPath": "assets/tab/plan.png",
        "selectedIconPath": "assets/tab/plan-active.png"
      },
      {
        "pagePath": "pages/log/log",
        "text": "记录",
        "iconPath": "assets/tab/log.png",
        "selectedIconPath": "assets/tab/log-active.png"
      },
      {
        "pagePath": "pages/diet/diet",
        "text": "饮食",
        "iconPath": "assets/tab/diet.png",
        "selectedIconPath": "assets/tab/diet-active.png"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的",
        "iconPath": "assets/tab/me.png",
        "selectedIconPath": "assets/tab/me-active.png"
      }
