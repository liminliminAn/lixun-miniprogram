<view class="card" bindtap="toggle">
  <view class="row">
    <view class="main">
      <text class="name">{{name}}</text>
      <text class="chev">{{expanded ? '收起' : '要点'}}</text>
    </view>
  </view>
  <view wx:if="{{expanded}}" class="body">
    <image class="img" src="/assets/exercise-placeholder.png" mode="aspectFill" />
    <view class="tip" wx:for="{{tips}}" wx:key="*this">
      <text class="bullet">●</text>
      <text>{{item}}</text>
    </view>
    <view class="focus" wx:if="{{tips[0]}}">今日只盯：{{tips[0]}}</view>
    <view class="warn">禁忌：{{contraindications}}</view>
  </view>
</view>
