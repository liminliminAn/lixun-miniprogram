.chart {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-4);
  border: 1rpx solid var(--color-border);
}
.empty {
  color: var(--color-ink-secondary);
  text-align: center;
  padding: var(--space-5);
  font-size: var(--font-meta);
}
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-3);
  font-size: var(--font-caption);
}
.date { width: 180rpx; color: var(--color-ink-secondary); }
.bar-wrap {
  flex: 1;
  height: 16rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 12rpx;
}
.bar {
  height: 100%;
  background: var(--color-accent);
  border-radius: 8rpx;
}
.kg {
  width: 120rpx;
  text-align: right;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
}
