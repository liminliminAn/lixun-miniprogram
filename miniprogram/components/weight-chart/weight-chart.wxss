.chart {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-4);
  border: 1rpx solid var(--color-border);
}
.empty {
  color: var(--color-ink-secondary);
  text-align: center;
  padding: var(--space-5);
  font-size: var(--font-meta);
}
.canvas { width: 100%; height: 360rpx; }
.legend { display: flex; align-items: center; gap: 12rpx; font-size: var(--font-caption); color: var(--color-ink-secondary); margin-top: 8rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--color-ink-secondary); }
.line { width: 32rpx; height: 4rpx; background: var(--color-accent); margin-left: 16rpx; }
.dot.solo { background: var(--color-accent); }
