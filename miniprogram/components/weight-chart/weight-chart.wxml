<view class="chart">
  <view class="empty" wx:if="{{empty}}">暂无体重记录</view>
  <block wx:else>
    <canvas type="2d" id="wchart" class="canvas"></canvas>
    <view class="legend">
      <text class="dot {{hasMa ? '' : 'solo'}}"></text><text>每日体重</text>
      <block wx:if="{{hasMa}}"><text class="line"></text><text>7 日均线</text></block>
    </view>
  </block>
</view>
