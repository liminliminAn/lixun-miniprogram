.title {
  font-weight: 600;
  font-size: var(--font-section);
  margin-bottom: 12rpx;
  color: var(--color-ink);
}
.hint {
  color: var(--color-ink-secondary);
  font-size: var(--font-caption);
  margin-bottom: 20rpx;
}
.week { display: flex; justify-content: space-between; }
.cell { flex: 1; text-align: center; }
.wd {
  display: block;
  color: var(--color-ink-secondary);
  font-size: var(--font-caption);
}
.dt {
  display: inline-block;
  margin-top: 8rpx;
  padding: 8rpx 0;
  width: 64rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  color: var(--color-ink);
  font-size: var(--font-meta);
}
.dt.push {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}
.dt.pull {
  background: rgba(27, 127, 90, 0.12);
  color: var(--color-success);
}
.dt.legs {
  background: rgba(196, 127, 23, 0.12);
  color: var(--color-warning);
}
.dt.rest {
  background: var(--color-bg);
  color: var(--color-ink-secondary);
}
.ex {
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-body);
  color: var(--color-ink);
  min-height: 64rpx;
  display: flex;
  align-items: center;
}
.ex:last-child { border-bottom: none; }
.cell { min-height: var(--hit-min); }
.restore {
  margin-top: 20rpx;
  text-align: center;
  min-height: var(--hit-min);
  line-height: var(--hit-min);
  color: var(--color-accent);
  font-size: var(--font-meta);
}
.week-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.nav-btn { width: var(--hit-min); min-height: var(--hit-min); line-height: var(--hit-min); text-align: center; font-size: var(--font-section); color: var(--color-accent); }
.nav-btn.disabled { color: var(--color-border); }
.range { font-size: var(--font-meta); color: var(--color-ink-secondary); }
.md { display: block; font-size: var(--font-caption); color: var(--color-ink-secondary); }
.cell.today { border-radius: 12rpx; background: var(--color-accent-soft); }
.cell.today .wd, .cell.today .md { color: var(--color-accent); font-weight: 600; }
.cell.past .dt { opacity: 0.6; }
.mark { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--color-ink-secondary); }
.cell.past .mark { color: var(--color-ink-secondary); }
.soft-tip { margin-top: 16rpx; font-size: var(--font-caption); color: var(--color-warning); }
.tag-custom { display: inline-block; margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 8rpx; font-size: var(--font-caption); font-weight: 400; vertical-align: middle; background: var(--color-accent-soft); color: var(--color-accent); }
.dt.none { width: auto; padding: 8rpx 4rpx; font-size: 20rpx; line-height: 1.3; background: transparent; color: var(--color-ink-secondary); }

.toggle { margin-top: 12rpx; text-align: center; min-height: var(--hit-min); line-height: var(--hit-min); color: var(--color-accent); font-size: var(--font-meta); }
.month-title { font-size: var(--font-body); font-weight: 600; color: var(--color-ink); }
.m-head { display: flex; }
.m-wd { flex: 1; text-align: center; font-size: var(--font-caption); color: var(--color-ink-secondary); padding-bottom: 8rpx; }
.m-grid { display: flex; flex-wrap: wrap; }
.m-cell { width: 14.2857%; min-height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rpx 0; box-sizing: border-box; }
.m-day { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 50%; font-size: var(--font-meta); color: var(--color-ink); }
.m-day.today { background: var(--color-accent); color: var(--color-accent-ink); font-weight: 600; }
.m-type { font-size: 20rpx; line-height: 1.2; color: var(--color-ink-secondary); }
.m-type.push { color: var(--color-accent); }
.m-type.pull, .m-type.done { color: var(--color-success); }
.m-type.legs { color: var(--color-warning); }
.m-cell.out { opacity: 0.35; }
.m-type.unfinished { color: var(--color-warning); }
