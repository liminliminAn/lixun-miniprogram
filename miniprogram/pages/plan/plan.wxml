<view class="container">
  <view class="card">
    <view class="title">本周课表（{{daysPerWeek}} 练）<text class="tag-custom" wx:if="{{customized}}">自定义</text></view>
    <view class="hint">今天及以后点某天可只改这一天为推/拉/腿/休；过去的日子点开看记录</view>
    <block wx:if="{{!expanded}}">
    <view class="week-nav">
      <view class="nav-btn" bindtap="onPrevWeek">‹</view>
      <text class="range">{{weekOffset === 0 ? '本周 · ' : ''}}{{weekRange}}</text>
      <view class="nav-btn {{weekOffset >= 0 ? 'disabled' : ''}}" bindtap="onNextWeek">›</view>
    </view>
    <view class="week">
      <view class="cell {{item.isToday ? 'today' : ''}} {{item.tense}}" wx:for="{{weekCells}}" wx:key="idx" data-idx="{{item.idx}}" bindtap="onTapDay">
        <text class="wd">周{{item.wd}}</text>
        <text class="md">{{item.md}}</text>
        <text class="dt {{item.noRecord ? 'rest' : item.dayType}}">{{item.label}}</text>
        <text class="mark" wx:if="{{item.tense === 'past' && item.hasRecord && !item.trained}}">未完成</text>
      </view>
    </view>
    </block>
    <view class="month" wx:else>
      <view class="week-nav">
        <view class="nav-btn {{monthOffset <= monthMin ? 'disabled' : ''}}" bindtap="onPrevMonth">‹</view>
        <text class="month-title">{{monthTitle}}</text>
        <view class="nav-btn {{monthOffset >= monthMax ? 'disabled' : ''}}" bindtap="onNextMonth">›</view>
      </view>
      <view class="m-head"><text class="m-wd" wx:for="{{monthHeader}}" wx:key="*this">{{item}}</text></view>
      <view class="m-grid">
        <view class="m-cell {{item.inMonth ? '' : 'out'}} {{item.tappable ? '' : 'static'}} {{item.tense}}" wx:for="{{monthCells}}" wx:key="date" data-i="{{index}}" bindtap="onTapMonthDay">
          <text class="m-day {{item.isToday ? 'today' : ''}}">{{item.day}}</text>
          <text class="m-type {{item.tense === 'past' && item.dayType && !item.trained ? 'unfinished' : (item.dayType || 'rest')}}">{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="toggle" bindtap="onToggleMonth">{{expanded ? '收起 ▴' : '展开 ▾'}}</view>
    <view class="soft-tip" wx:if="{{streakTip}}">{{streakTip}}</view>
    <view class="restore" wx:if="{{restorable}}" bindtap="onRestoreDefault">恢复默认</view>
  </view>

  <view class="card" wx:for="{{dayBlocks}}" wx:key="dayType">
    <view class="title">{{item.label}}日动作</view>
    <view class="ex" wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="id">{{ex.name}}</view>
  </view>
</view>
