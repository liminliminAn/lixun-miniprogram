<view class="container">
  <view class="card user" wx:if="{{user}}">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{user.avatarPath || defaultAvatar}}" mode="aspectFill" />
    </button>
    <view class="user-main">
      <input class="nick" type="nickname" value="{{nickDraft}}" bindinput="onNickInput" bindblur="onNickSave" bindconfirm="onNickSave" placeholder="1–20 个字" />
      <view class="meta">{{user.guest ? '试用中 · ' : ''}}点头像或昵称可修改</view>
    </view>
  </view>
  <view class="card" wx:if="{{profile}}">
    <view class="title">档案</view>
    <view class="row"><text>人群</text><text>{{crowdName}}</text></view>
    <view class="row"><text>性别</text><text>{{profile.sex === 'male' ? '男' : '女'}}</text></view>
    <view class="row"><text>身高/体重</text><text>{{profile.heightCm}} cm / {{profile.weightKg}} kg</text></view>
    <view class="row"><text>体脂区间</text><text>{{profile.bfBand}}</text></view>
    <view class="row"><text>目标</text><text>{{profile.goal}}</text></view>
    <view class="row"><text>每周</text><text>{{profile.daysPerWeek}} 练</text></view>
  </view>

  <view class="card">
    <view class="title">偏好</view>
    <view class="row"><text>连练软提示阈值</text><text>> {{restSoftWarnDays}} 天</text></view>
    <view class="row"><text>开练前显示热身</text><switch checked="{{showWarmup}}" bindchange="onWarmupChange" /></view>
  </view>

  <view class="card" bindtap="onPosture">
    <view class="row"><text>体态矫正</text><text>›</text></view>
  </view>

  <view class="card danger" bindtap="onReset">
    <text>退出并清除本地数据</text>
  </view>

  <view class="foot">{{localOnly}}</view>
  <view class="foot">力训 v0.1 · 仅本地存储 · 基础库 ≥ 2.32.0</view>
</view>
