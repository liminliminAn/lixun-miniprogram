.h1 {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--color-ink);
}
.sub {
  color: var(--color-ink-secondary);
  font-size: var(--font-caption);
  margin-top: 8rpx;
  line-height: 1.5;
}
.title {
  font-weight: 600;
  font-size: var(--font-section);
  margin-bottom: 8rpx;
  color: var(--color-ink);
}
.summary {
  color: var(--color-ink-secondary);
  font-size: var(--font-caption);
  margin-bottom: 16rpx;
}
.item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-meta);
  line-height: 1.5;
  color: var(--color-ink);
}
.item:last-child { border-bottom: none; }

.row { display: flex; margin: 24rpx 0; }
.cell { flex: 1; text-align: center; }
.num { font-size: var(--font-title); font-weight: 700; color: var(--color-accent); }
.lab { font-size: var(--font-caption); color: var(--color-ink-secondary); margin-top: 4rpx; }
.check {
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-ink);
  font-size: var(--font-meta);
}
.check.on { background: var(--color-accent); color: var(--color-accent-ink); border-color: var(--color-accent); }
.disclaimer { margin-top: 16rpx; font-size: var(--font-caption); color: var(--color-ink-secondary); text-align: center; }
