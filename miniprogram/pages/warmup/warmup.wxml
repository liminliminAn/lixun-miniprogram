<view class="container">
  <view class="card head">
    <view>
      <view class="title">{{dayLabel}}日热身</view>
      <view class="sub">{{pickNote}}；可逐项勾选，也可整段跳过</view>
      <view class="sub">{{doseNote}}</view>
    </view>
    <view class="timer {{running ? 'on' : ''}}" bindtap="onToggleTimer">{{timeText}} {{running ? '暂停' : '计时'}}</view>
  </view>

  <view class="card" wx:for="{{sections}}" wx:for-item="sec" wx:key="key">
    <view class="title">{{sec.title}}<text class="opt" wx:if="{{sec.optional}}">可选</text></view>
    <view class="sub" wx:if="{{sec.frequency}}">频率：{{sec.frequency}}</view>
    <view class="item" wx:for="{{sec.items}}" wx:key="id" data-sec="{{sec.key}}" data-idx="{{index}}" bindtap="onToggleItem">
      <text class="box {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</text>
      <view class="txt">
        <view class="move">
          <text>{{item.text}}</text>
          <text class="link" wx:if="{{item.source}}" data-url="{{item.source.url}}" catchtap="onCopyLink" user-select>动作{{item.source.title}} {{item.source.url}}（点按复制）</text>
        </view>
        <image class="wu-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" />
        <view class="sub-tip" wx:for="{{item.steps}}" wx:for-item="st" wx:for-index="si" wx:key="*this">{{si + 1}}. {{st}}</view>
        <view class="sub-tip" wx:for="{{item.cues}}" wx:for-item="cu" wx:key="*this">● {{cu}}</view>
        <text class="link" wx:if="{{item.video}}" data-copy="{{item.video.copyText}}" catchtap="onCopyVideo">▶ 视频参考 {{item.video.time}}（点按复制，在抖音打开）</text>
        <view class="dose-row" wx:if="{{item.dose}}"><text class="dose">{{item.dose}}</text><text class="dose-label">{{doseLabel}}</text></view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{ramp.length}}">
    <view class="title">坡道组 · {{rampName}}</view>
    <view class="sub">不计入训练容量</view>
    <view class="item" wx:for="{{ramp}}" wx:key="id" data-sec="ramp" data-idx="{{index}}" bindtap="onToggleItem">
      <text class="box {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>

  <view class="link block" wx:if="{{dayVideo}}" data-copy="{{dayVideo.copyText}}" bindtap="onCopyVideo">▶ 视频参考{{dayVideo.note ? ' · ' + dayVideo.note : ''}} {{dayVideo.time}}（点按复制，在抖音打开）</view>
  <view class="link block" wx:if="{{daySource}}" data-url="{{daySource.url}}" bindtap="onCopyLink" user-select>动作参考来源 · {{daySource.title}} {{daySource.url}}（点按复制）</view>

  <view class="actions">
    <view class="btn ghost" bindtap="onSkip">跳过热身</view>
    <view class="btn primary" bindtap="onDone">完成热身，开练</view>
  </view>
</view>
